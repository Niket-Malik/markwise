# Compose uses the local PostgreSQL service when this is blank. For local backend/Alembic
# with Neon, enter the Neon pooled URL in backend/.env; remote PostgreSQL URLs use TLS.
DATABASE_URL=
POSTGRES_PASSWORD=replace-with-random-db-password
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_MAX_REQUESTS_PER_MINUTE=15
GEMINI_API_KEY=<optional-google-gemini-fallback-key>
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_TEXT_MODEL_ALTERNATE=gemini-3.5-flash-lite
GEMINI_VISION_MODEL_ALTERNATE=gemini-3.5-flash-lite
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
EMBEDDING_DIMENSIONS=1536
AI_TIMEOUT_SECONDS=30
AI_PROVIDER_MAX_RETRIES=2
AI_RETRY_BASE_SECONDS=0.5
AI_RETRY_MAX_SECONDS=4
AI_CIRCUIT_BREAKER_FAILURES=3
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
OCR_LANGUAGE=eng
# Supabase S3 credentials are server-only and bypass bucket RLS; store actual values in backend/.env.
S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_BUCKET=<bucket-name>
S3_REGION=<project-region-from-supabase-s3-settings>
S3_ACCESS_KEY_ID=<server-side-access-key-id>
S3_SECRET_ACCESS_KEY=<server-side-secret-access-key>
S3_SERVER_SIDE_ENCRYPTION=
S3_SSE_KMS_KEY_ID=
RETENTION_INTERVAL_SECONDS=86400
CORS_ORIGINS=http://localhost:3000
FRONTEND_HOST=
NEXT_PUBLIC_API_URL=http://localhost:8000
# Workspace admins must explicitly enable both external AI and OpenRouter consent in Settings.
# The OpenRouter request budget and HTTP rate limits are per process, not shared across replicas.
