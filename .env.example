# Compose uses the local PostgreSQL service when this is blank. For local backend/Alembic
# with Neon, enter the Neon pooled URL in backend/.env; remote PostgreSQL URLs use TLS.
DATABASE_URL=
POSTGRES_PASSWORD=replace-with-random-db-password
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
AI_PROVIDER=
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
VISION_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT_SECONDS=30
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
OCR_LANGUAGE=eng
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_SSE_KMS_KEY_ID=
RETENTION_INTERVAL_SECONDS=86400
CORS_ORIGINS=http://localhost:3000
FRONTEND_HOST=
NEXT_PUBLIC_API_URL=http://localhost:8000
