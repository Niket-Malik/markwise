# Compose uses the local PostgreSQL service when this is blank. For local backend/Alembic
# with Neon, enter the Neon pooled URL in backend/.env; remote PostgreSQL URLs use TLS.
DATABASE_URL=
POSTGRES_PASSWORD=replace-with-random-db-password
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
AI_PROVIDER=gemini
GEMINI_API_KEY=<your-google-gemini-api-key>
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_TEXT_MODEL_ALTERNATE=gemini-3.7-flash
GEMINI_VISION_MODEL_ALTERNATE=gemini-3.7-flash
AI_FALLBACK_PROVIDER=openai_compatible
AI_FALLBACK_API_BASE_URL=https://api.openai.com/v1
AI_FALLBACK_API_KEY=<your-openai-api-key>
AI_FALLBACK_TEXT_MODEL=gpt-6-luna
AI_FALLBACK_VISION_MODEL=gpt-6-luna
AI_FALLBACK_TEXT_MODEL_ALTERNATE=gpt-5.6-luna
AI_FALLBACK_VISION_MODEL_ALTERNATE=gpt-5.6-luna
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT_SECONDS=30
AI_PROVIDER_MAX_RETRIES=2
AI_RETRY_BASE_SECONDS=0.5
AI_RETRY_MAX_SECONDS=4
AI_CIRCUIT_BREAKER_FAILURES=3
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
OCR_LANGUAGE=eng
# Supabase S3 credentials are server-only and bypass bucket RLS; store actual values in backend/.env.
S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_BUCKET=<bucket-name>
S3_REGION=<project-region-from-supabase-s3-settings>
S3_ACCESS_KEY_ID=<server-side-access-key-id>
S3_SECRET_ACCESS_KEY=<server-side-secret-access-key>
S3_SERVER_SIDE_ENCRYPTION=
S3_SSE_KMS_KEY_ID=
RETENTION_INTERVAL_SECONDS=86400
CORS_ORIGINS=http://localhost:3000
FRONTEND_HOST=
NEXT_PUBLIC_API_URL=http://localhost:8000
