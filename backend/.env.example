# Copy this file to backend/.env and set DATABASE_URL to your Neon pooled connection URL.
# Keep the provider's ?sslmode=require query parameter. The application also enforces TLS
# for remote PostgreSQL hosts and selects the installed psycopg 3 SQLAlchemy driver.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:3000
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_MAX_REQUESTS_PER_MINUTE=15
GEMINI_API_KEY=<optional-gemini-fallback-key>
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_TEXT_MODEL_ALTERNATE=gemini-3.7-flash
GEMINI_VISION_MODEL_ALTERNATE=gemini-3.7-flash
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
EMBEDDING_DIMENSIONS=1536
AI_TIMEOUT_SECONDS=30
AI_PROVIDER_MAX_RETRIES=1
AI_RETRY_BASE_SECONDS=0.5
AI_RETRY_MAX_SECONDS=4
AI_CIRCUIT_BREAKER_FAILURES=3
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
# OpenRouter's free model may log requests and can be used to improve provider products.
# Workspace admins must separately opt in before Markwise sends any workspace data to it.

STORAGE_BACKEND=s3
# Copy endpoint and region exactly from Supabase Project Settings > Storage > S3.
# Keep the actual generated server-side keys only in this ignored backend/.env file.
S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_BUCKET=<bucket-name>
S3_REGION=<project-region-from-supabase-s3-settings>
S3_ACCESS_KEY_ID=<server-side-access-key-id>
S3_SECRET_ACCESS_KEY=<server-side-secret-access-key>
# Supabase S3 PutObject rejects x-amz-server-side-encryption headers.
S3_SERVER_SIDE_ENCRYPTION=
S3_SSE_KMS_KEY_ID=
